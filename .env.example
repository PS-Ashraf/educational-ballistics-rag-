# Ollama configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Vector DB & Embeddings configuration
# Can be a SentenceTransformer model (e.g. all-MiniLM-L6-v2) or "ollama" to use Ollama's embeddings API
EMBEDDING_MODEL_TYPE=sentence-transformer
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Storage paths (relative or absolute)
VECTOR_DB_DIR=./vector_store
UPLOAD_DIR=./knowledge_base/documents

# API host and port
API_HOST=127.0.0.1
API_PORT=8000

# MCP configuration
MCP_PORT=8001
